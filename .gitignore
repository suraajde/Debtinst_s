# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Build artifacts
build/
*.egg-info/
.eggs/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Local databases auto-materialized at runtime (seed is embedded in src/embedded_seed.py)
data/*.db
data/*.sqlite
data/*.sqlite3
!data/.gitkeep

# Zero-install portable bundle tracking
!dist_portable/
!dist_portable/**

# OS generated files
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
